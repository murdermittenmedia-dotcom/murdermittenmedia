{
  "name": "murdermittenmedia-tikfinity-review-bridge-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Same-PC TikFinity loopback reader with authenticated outbound HTTPS; no audio or local server",
  "engines": { "node": ">=22" },
